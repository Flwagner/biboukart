{
  "name": "biboukart",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:static": "node scripts/verify-static.mjs",
    "benchmark": "node scripts/benchmark.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/three": "^0.180.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "vite": "^7.1.12",
    "vitest": "^5.1.0"
  }
}
